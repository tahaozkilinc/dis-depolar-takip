+        title="Ürünler"
+        items={(products ?? []) as Product[]}
+        showUnit
+        onAdd={addProduct}
+        onDelete={deleteProduct}
+      />
+
+      <CrudSection
+        title="Varış Noktaları"
+        items={(destinations ?? []) as Destination[]}
+        showUnit={false}
+        onAdd={addDestination}
+        onDelete={deleteDestination}
+      />
+    </div>
+  );
+}
