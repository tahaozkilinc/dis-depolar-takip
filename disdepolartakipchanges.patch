+    );
+  }, [balances, selectedWarehouse]);
+
+  const selectedBalance = productOptions.find(
+    (p) => p.product_id === selectedProduct
+  );
+
+  const overLimit =
+    selectedBalance &&
+    tonnage &&
+    parseFloat(tonnage) > selectedBalance.remaining_tonnage;
